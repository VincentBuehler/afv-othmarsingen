# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die Kontaktadresse landet im User-Agent, damit der AFV sieht, wer anfragt.
AFV_CONTACT=deine.adresse@example.com

# Anderer Verein? Nur diese beiden Zeilen anpassen.
# AFV_CLUB_ID=269
# AFV_CLUB_NAME=FC Othmarsingen
# AFV_CLUB_MATCH_NAME=Othmarsingen

# Sekunden zwischen zwei Requests ans Matchcenter. Nicht kleiner machen.
# AFV_REQUEST_DELAY=6.0
