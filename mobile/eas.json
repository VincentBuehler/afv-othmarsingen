{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  },
  "updates": {
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://vincentbuehler.github.io/afv-othmarsingen/api",
        "EXPO_PUBLIC_API_MODE": "static"
      }
    }
  }
}
